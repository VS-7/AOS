# @json-render/shadcn peer-depends on zod ^4.0.0 while this project is on
# zod ^3.25.76 (which @ai-sdk/gateway pins us to). npm refuses that on a plain
# install, so every entry point that installs — the root Taskfile, Wails' own
# `common:install:frontend:deps:npm`, and anyone typing `npm install` by hand —
# needs the flag. Setting it here instead of on each call site means none of
# them can be missed: patching them one at a time is how `task build:desktop`
# came to work while `wails3 dev` still failed.
#
# The forced resolution is safe as long as the only importer of @json-render/*
# is the `view` feature, which has no Go backend and renders the dormant panel
# without executing. Revisit when that domain goes live — see
# docs/superpowers/specs/2026-08-18-porte-frontend-fractal-design.md.
legacy-peer-deps=true

<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="aos-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\AOS\AOS">
    </Installer>
    <PackageInformation
        PackageName="AOS"
        PackageDisplayName="AOS"
        PublisherName="CN=AOS"
        PublisherDisplayName="AOS"
        Version="0.1.0.0"
        PackageDescription="An operating system for AI agents.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.owner.aos"
                Description="An operating system for AI agents."
                DisplayName="AOS"
                ExecutableName="aos-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AOS</DisplayName>
            <PublisherDisplayName>AOS</PublisherDisplayName>
            <Description>An operating system for AI agents.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="aos-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>

        "no_priority",
        "urgent",
        "high",
        "medium",
        "low"
      ]
    },
    "summary": {
      "type": [
        "null",
        "string"
      ],
      "description": "New summary."
    },
    "dueAt": {
      "type": [
        "null",
        "string"
      ],
      "description": "New due date, RFC3339. Empty clears it."
    },
    "project": {
      "type": [
        "null",
        "string"
      ],
      "description": "New project."
    },
    "goal": {
      "type": [
        "null",
        "string"
      ],
      "description": "New goal."
    },
    "dependsOn": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      },
      "description": "New dependency list. Replaces the old one whole."
    },
    "chat": {
      "type": [
        "null",
        "string"
      ],
      "description": "Conversation this task's execution runs in."
    },
    "content": {
      "type": [
        "null",
        "string"
      ],
      "description": "New description and plan, in Markdown."
    },
    "status": {
      "type": "string",
      "description": "Not writable here. Use set-status, which validates the move and runs the guards.",
      "enum": [
        "suggestion",
        "backlog",
        "planning",
        "todo",

/dist/
/frontend/node_modules/
/frontend/dist/
*.test.log
.env
.env.local
.DS_Store
/testdata/**/large/
/coverage.out

# The desktop's copy of the frontend bundle. `task build:desktop` puts it there
# because a Go embed pattern cannot reach outside its own package; committing a
# build output would put a stale interface in the history.
/cmd/aos-desktop/dist/

# go-task's local up-to-date cache (source hashes for `sources:`/`generates:`
# checks) — machine-local, rebuilds itself, nothing to diff.
/.task/

# A workspace's own data, scaffolded by `workspace introspect`/`create` inside
# whatever repository is registered — agents, skills, instructions and the
# rest live under here when this repository itself is used as a workspace
# (e.g. for local development). Per-installation state, not source.
/.aos/
.env.sample

# Generated by `wails3 generate bindings`. Nothing imports from here —
# client.ts calls DomainService.Invoke directly by its fully qualified Go
# name (see its own comment for why) — so this would be dead code kept in
# sync with Go source for no reader. Regenerate on demand if that changes.
/frontend/bindings/

# A stock `wails3 init` scaffold kept alongside the real project purely as a
# reference for what a default Wails3 app looks like — not part of AOS.
/exemplo-wails3-ultima-versao/
